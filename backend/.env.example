# Copy this file to .env and fill in whichever keys you have.
# DarkWeb Watchdog runs fully in DEMO MODE with zero keys set — every
# checker below falls back to realistic, deterministic mock data so the
# app is always demoable. Add real keys to switch any single checker to
# live data without touching code.

# --- AI Summary + Chatbot (OpenAI) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Breach data (HaveIBeenPwned) ---
# Paid key ($3.95/mo+) at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- Domain / URL reputation (VirusTotal) ---
# Free tier key at https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# --- Exposed infra (Shodan) ---
# Free trial key at https://account.shodan.io/register
SHODAN_API_KEY=

# --- GitHub code search (exposed secrets) ---
# Optional but recommended: raises rate limit from 10/min to 30/min.
# Create a classic token (no scopes needed) at https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Login (Sign in with Google) ---
# Required for the login page to work. Create an OAuth 2.0 Client ID of
# type "Web application" at https://console.cloud.google.com/apis/credentials
# and add the URL you'll open the app from (e.g. http://localhost:8000)
# under "Authorized JavaScript origins". No redirect URI is needed.
GOOGLE_CLIENT_ID=

# --- Session signing secret ---
# Any long random string, used to sign this app's own login sessions
# (separate from Google's token). Change this to something random.
JWT_SECRET=change-this-to-a-long-random-string

# --- Database (case history) ---
# Defaults to a local SQLite file (backend/ap_console.db) — nothing to
# set up. Point this at a Postgres/MySQL URL instead for a shared,
# server-side database, e.g. postgresql://user:pass@host/dbname
# DATABASE_URL=sqlite:///./ap_console.db
